NEXT_PUBLIC_SITE_URL=
# IANA timezone used to render event dates (defaults to UTC).
NEXT_PUBLIC_SITE_TIMEZONE=UTC
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
# Shared secret for POST /api/revalidate (Sanity webhook).
SANITY_REVALIDATE_SECRET=

# --- Phase 2: Google booking + Gmail ---
# Postgres connection string (Supabase → Project Settings → Database)
DATABASE_URL=

# Auth.js / NextAuth
AUTH_SECRET=
# Same value Auth.js reads for the app URL in production
AUTH_URL=http://127.0.0.1:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated photographer admin emails (must match Google account)
ADMIN_EMAILS=
