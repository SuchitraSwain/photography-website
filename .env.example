NEXT_PUBLIC_SITE_URL=
# IANA timezone used to render event dates (defaults to UTC).
NEXT_PUBLIC_SITE_TIMEZONE=UTC
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
# Shared secret for POST /api/revalidate (Sanity webhook).
SANITY_REVALIDATE_SECRET=

# --- Client-side form & booking (no custom backend) ---
# Formspree form ID from https://formspree.io (public; safe for NEXT_PUBLIC_)
NEXT_PUBLIC_FORMSPREE_ID=
# Cal.com or Calendly booking URL used as an iframe embed on /booking
NEXT_PUBLIC_CAL_URL=https://cal.com/your-username/30min

# --- Optional / legacy: Google booking + Gmail (not required for static deploy) ---
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
