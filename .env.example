NEXT_PUBLIC_SITE_URL=
# IANA timezone used to render event dates (defaults to UTC).
NEXT_PUBLIC_SITE_TIMEZONE=UTC

# --- Client-side form & booking ---
# Formspree form ID from https://formspree.io (public; safe for NEXT_PUBLIC_)
NEXT_PUBLIC_FORMSPREE_ID=
# Cal.com or Calendly booking URL used as an iframe embed on /booking
NEXT_PUBLIC_CAL_URL=https://cal.com/your-username/30min

# --- Database + auth (required for /admin media & bookings) ---
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=

# Vercel Blob read/write token (Storage → Blob in Vercel dashboard)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Optional shared secret for POST /api/revalidate
REVALIDATE_SECRET=
